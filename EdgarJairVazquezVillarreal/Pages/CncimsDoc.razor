@page "/docs/cncims"
@inherits DocPageBase

<PageTitle>CNCIMS - @T("Documentación", "Documentation")</PageTitle>

<DocPage Title="CNCIMS"
         Subtitle="@LangApp.Get("ProjCncSubtitle")"
         Icon="bi-vector-pen"
         Tags="@Tags">

    <DocSection Id="descripcion" Icon="bi-info-circle" Title="@T("Descripción General", "Overview")">
        <p class="doc-lead scroll-reveal">
            @T("Conversión de una cortadora láser CO2 recuperada en una estación CNC de grabado mecánico para placas de identificación de tableros (lamicoid), con un software CAM de escritorio hecho a la medida. Me encargué de la puesta en marcha completa: hardware, firmware y software.",
               "Conversion of a salvaged CO2 laser cutter into a mechanical CNC engraving station for control panel nameplates (lamicoid), with a custom desktop CAM application. I handled the full bring-up: hardware, firmware and software.")
        </p>

        <div class="doc-metrics mt-4">
            <DocMetric Value="900" Suffix="+" Label="@T("Pruebas automatizadas", "Automated tests")" />
            <DocMetric Value="47" Label="@T("Pruebas en el protocolo de validación", "Tests in the validation protocol")" />
            <DocMetric Value="3" Label="@T("Capas: hardware, firmware y software", "Layers: hardware, firmware and software")" />
        </div>

        <p class="doc-note scroll-reveal mt-4">
            <i class="bi bi-shield-lock-fill"></i>
            <span>
                @T("Es un proyecto de mi trabajo: por confidencialidad no se muestran planos, datos de producción ni código fuente.",
                   "This is a project from my job: for confidentiality, no drawings, production data or source code are shown.")
            </span>
        </p>
    </DocSection>

    @if (Gallery.Length > 0)
    {
        <DocSection Id="capturas" Icon="bi-images" Title="@T("Capturas", "Screenshots")">
            <DocGallery Images="@Gallery" />
        </DocSection>
    }

    <DocSection Id="hardware" Icon="bi-cpu" Title="@T("Hardware y Puesta en Marcha", "Hardware & Bring-up")">
        <p class="doc-text scroll-reveal">
            @T("La máquina base era una cortadora láser fuera de uso. Antes de poder grabar hubo que dejar confiable la parte eléctrica y el control de movimiento:",
               "The base machine was a decommissioned laser cutter. Before it could engrave, the electrical side and the motion control had to be made reliable:")
        </p>
        <DocCard>
            <ul class="tech-list">
                @foreach (var item in Hardware)
                {
                    <li>@T(item)</li>
                }
            </ul>
        </DocCard>
    </DocSection>

    <DocSection Id="software" Icon="bi-window-stack" Title="@T("Software CAM", "CAM Software")">
        <div class="doc-grid doc-grid-2">
            @foreach (var feature in CamFeatures)
            {
                <DocCard Icon="@feature.Icon" Title="@T(feature.Title)" Description="@T(feature.Detail)" />
            }
        </div>
    </DocSection>

    <DocSection Id="ejecucion" Icon="bi-play-circle" Title="@T("Ejecución y Seguridad", "Execution & Safety")">
        <DocCard>
            <ul class="tech-list">
                @foreach (var item in Execution)
                {
                    <li>@T(item)</li>
                }
            </ul>
        </DocCard>
    </DocSection>

    <DocSection Id="calidad" Icon="bi-check2-square" Title="@T("Calidad y Validación", "Quality & Validation")">
        <p class="doc-text scroll-reveal">
            @T("La lógica (comunicación con el controlador, generación de G-code y ciclo de grabado) vive en una capa sin dependencias de la interfaz, lo que permite probarla de forma automática.",
               "The logic (controller communication, G-code generation and the engraving cycle) lives in a layer with no UI dependencies, which makes it possible to test it automatically.")
        </p>
        <DocCard>
            <ul class="tech-list">
                @foreach (var item in Quality)
                {
                    <li>@T(item)</li>
                }
            </ul>
        </DocCard>
    </DocSection>

    <DocSection Id="depuracion" Icon="bi-bug" Title="@T("Problemas que Resolví", "Problems I Solved")">
        <div class="doc-callout scroll-reveal">
            <ul class="tech-list">
                @foreach (var bug in Debugging)
                {
                    <li><strong>@T(bug.Title):</strong> @T(bug.Detail)</li>
                }
            </ul>
        </div>
    </DocSection>
</DocPage>

