@page "/"
@inject EdgarJairVazquezVillarreal.Services.LanguageService LangApp
@implements IDisposable

<PageTitle>Edgar Jair Vazquez V. — @LangApp.Get("HeroRole1")</PageTitle>

<!-- ── Hero ───────────────────────────────────────────────────────── -->
<section class="hero">
    <div class="row align-items-center g-4">
        <div class="col-xl-7">
            <p class="hero-eyebrow scroll-reveal">@LangApp.Get("HeroGreeting")</p>

            <h1 class="hero-name scroll-reveal">
                Edgar Jair <span class="text-gradient d-block">Vazquez Villarreal</span>
            </h1>

            <!-- El texto lo teclea js/animations.js a partir de data-typed -->
            <p class="hero-role scroll-reveal">
                <span class="hero-role-prompt" aria-hidden="true">&gt;</span><span class="typed-text" data-typed="@string.Join('|', Roles)" aria-hidden="true"></span>
                <span class="visually-hidden">@string.Join(", ", Roles)</span>
            </p>

            <p class="hero-tagline scroll-reveal">@LangApp.Get("HeroTagline")</p>

            <div class="hero-actions scroll-reveal">
                <a href="projects" class="btn btn-primary">
                    <i class="bi bi-grid-1x2-fill me-2"></i>@LangApp.Get("ViewProjects")
                </a>
                <a href="ImagenesDocs/CVEdgarJairVazquezVillarreal.pdf"
                   class="btn btn-outline-primary" target="_blank">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i>@LangApp.Get("DownloadCV")
                </a>
            </div>

            <div class="hero-social scroll-reveal">
                <a href="https://github.com/Kaiser1088" target="_blank" aria-label="GitHub">
                    <i class="bi bi-github"></i>
                </a>
                <a href="https://www.linkedin.com/in/edgar-vazquez-83b9431b8/" target="_blank" aria-label="LinkedIn">
                    <i class="bi bi-linkedin"></i>
                </a>
                <a href="contact" aria-label="@LangApp.Get("NavContact")">
                    <i class="bi bi-envelope-fill"></i>
                </a>
            </div>
        </div>

        <!-- Tarjeta de código decorativa (siempre oscura, como el sidebar) -->
        <div class="col-xl-5 d-none d-xl-block" aria-hidden="true">
            <div class="hero-visual scroll-reveal">
                <div class="code-card float-soft" data-bs-theme="dark">
                    <div class="code-card-bar">
                        <span class="code-card-dot"></span>
                        <span class="code-card-dot"></span>
                        <span class="code-card-dot"></span>
                        <span class="code-card-file">Perfil.cs</span>
                    </div>
                    <div class="code-card-body">
                        <div class="code-line"><span class="tk-kw">var</span> edgar = <span class="tk-kw">new</span> <span class="tk-type">Engineer</span></div>
                        <div class="code-line">{</div>
                        <div class="code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-prop">Degree</span> = <span class="tk-str">"@LangApp.Get("HeroCodeDegree")"</span>,</div>
                        <div class="code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-prop">Software</span> = [<span class="tk-str">"C#"</span>, <span class="tk-str">".NET"</span>, <span class="tk-str">"SQL"</span>],</div>
                        <div class="code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-prop">Controls</span> = [<span class="tk-str">"PLC"</span>, <span class="tk-str">"SCADA"</span>],</div>
                        <div class="code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-prop">Robots</span> = [<span class="tk-str">"FANUC"</span>, <span class="tk-str">"KUKA"</span>],</div>
                        <div class="code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-prop">Hardware</span> = [<span class="tk-str">"ESP32"</span>, <span class="tk-str">"PCB"</span>, <span class="tk-str">"CNC"</span>],</div>
                        <div class="code-line">};</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Cifras ─────────────────────────────────────────────────────── -->
<section class="stat-band scroll-reveal">
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="2">2</span></div>
        <div class="stat-label">@LangApp.Get("StatErp")</div>
    </div>
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="120">120</span>+</div>
        <div class="stat-label">@LangApp.Get("StatEndpoints")</div>
    </div>
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="900">900</span>+</div>
        <div class="stat-label">@LangApp.Get("StatTests")</div>
    </div>
    <div class="stat">
        <div class="stat-value">CSWP</div>
        <div class="stat-label">@LangApp.Get("StatCswp")</div>
    </div>
</section>

<!-- ── Proyectos destacados ───────────────────────────────────────── -->
<section class="home-section">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-stars"></i>@LangApp.Get("HomeFeaturedTitle")</h2>
        <a href="projects" class="section-link">
            @LangApp.Get("HomeAllProjects")<i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row">
        @foreach (var project in Featured)
        {
            <div class="@(project.Wide ? "col-12" : "col-lg-6") mb-4">
                <div class="card h-100 featured-card scroll-reveal">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="featured-icon"><i class="bi @project.Icon"></i></div>
                            <div>
                                <h3 class="h5 card-title mb-0">@project.Name</h3>
                                <div class="featured-subtitle">@LangApp.Get(project.SubtitleKey)</div>
                            </div>
                        </div>
                        <p class="card-text">@LangApp.Get(project.DescKey)</p>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (var tag in project.Tags)
                            {
                                <span class="badge badge-glass">@tag</span>
                            }
                        </div>
                        <a href="@project.Href" class="featured-link stretched-link mt-auto">
                            @LangApp.Get("ViewDocs")<i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ── Sobre mí ───────────────────────────────────────────────────── -->
<section class="home-section">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-person-fill"></i>@LangApp.Get("HomeTitle")</h2>
    </div>

    <p class="about-lead scroll-reveal">@LangApp.Get("BioP1")</p>
    <p class="about-lead scroll-reveal">@LangApp.Get("BioP2")</p>

    <p class="about-goal scroll-reveal">
        <i class="bi bi-signpost-split-fill"></i>
        <span><strong>@LangApp.Get("BioGoalLabel"):</strong> @LangApp.Get("BioGoal")</span>
    </p>
</section>

<!-- ── Habilidades ────────────────────────────────────────────────── -->
<section class="home-section">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-tools"></i>@LangApp.Get("HomeSkillsTitle")</h2>
    </div>

    <div class="row">
        @foreach (var group in Skills)
        {
            <div class="col-md-6 col-xl-4 mb-4">
                <div class="glass-card scroll-reveal h-100 p-4">
                    <h3 class="h5 mb-3 text-neon">
                        <i class="bi @group.Icon me-2"></i>@T(group.Title)
                    </h3>
                    <ul class="tech-list">
                        @foreach (var item in group.Items)
                        {
                            <li>@T(item)</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <div class="lang-row scroll-reveal">
        <span class="lang-row-title"><i class="bi bi-translate me-2"></i>@LangApp.Get("LanguagesTitle")</span>
        <span class="badge badge-glass">@LangApp.Get("LangSpanish")</span>
        <span class="badge badge-glass">@LangApp.Get("LangEnglish")</span>
    </div>
</section>

<!-- ── Logros y participaciones ───────────────────────────────────── -->
<section class="home-section mb-5">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-trophy-fill"></i>@LangApp.Get("CareerAndAchievements")</h2>
    </div>

    <div class="row">
        <div class="col-md-6 scroll-reveal">
            <p><strong>@LangApp.Get("RoboticsSkills"):</strong></p>
            <ul class="list-unstyled">
                <li>
                    <i class="bi bi-trophy-fill text-warning me-2"></i>
                    <strong>@LangApp.Get("RobotBattle2018"):</strong>
                    @LangApp.Get("ParticipationWithTeamDynamo")
                </li>
                <li>
                    <i class="bi bi-trophy-fill text-warning me-2"></i>
                    <strong>@LangApp.Get("RobotCIM"):</strong>
                    @LangApp.Get("ParticipationWithTeamDynamoInCategories")
                </li>
                <li>
                    <i class="bi bi-trophy-fill text-warning me-2"></i>
                    <strong>@LangApp.Get("StateRoboticsNL"):</strong>
                    @LangApp.Get("FirstAndSecondPlaceInSumoAndMinisumo")
                </li>
            </ul>
        </div>

        <div class="col-md-6 scroll-reveal">
            <p><strong>@LangApp.Get("TechnologicalInnovation"):</strong></p>
            <ul class="list-unstyled">
                <li>
                    <i class="bi bi-award-fill text-warning me-2"></i>
                    @LangApp.Get("ParticipationScienceFair2019")
                </li>
                <li>
                    <i class="bi bi-award-fill text-warning me-2"></i>
                    @LangApp.Get("ParticipationScienceFair2020")
                </li>
            </ul>
        </div>
    </div>
</section>

@code {
    private record FeaturedProject(string Name, string Icon, string SubtitleKey, string DescKey, string Href, string[] Tags, bool Wide = false);

    private record SkillGroup(string Icon, (string Es, string En) Title, (string Es, string En)[] Items);

    // Frases que se teclean en el hero
    private string[] Roles => new[]
    {
        LangApp.Get("HeroRole1"),
        LangApp.Get("HeroRole2"),
        LangApp.Get("HeroRole3"),
        LangApp.Get("HeroRole4"),
    };

    private static readonly FeaturedProject[] Featured =
    {
        new("CNCIMS", "bi-vector-pen", "ProjCncSubtitle", "ProjCncDesc", "docs/cncims",
            new[] { "C# / .NET 10", "WPF", "ESP32-S3", "FluidNC", "G-code", "DXF" }, Wide: true),
        new("VAVILL", "bi-buildings", "ProjVavillSubtitle", "ProjVavillDesc", "docs/vavill",
            new[] { ".NET 8", "Blazor WebAssembly", "RCL Modular", "SQL Server" }),
        new("EsmeraldaPoint", "bi-shop", "ProjEsmeraldaSubtitle", "ProjEsmeraldaDesc", "docs/esmeraldapoint",
            new[] { "ASP.NET Core 10", "Blazor", "WPF", "PostgreSQL" }),
    };

    // Habilidades por área. Para agregar una basta una línea en su grupo.
    private static readonly SkillGroup[] Skills =
    {
        new("bi-cpu", ("PLC y controles", "PLC & controls"), new[]
        {
            ("Siemens TIA Portal (S7-1200)", "Siemens TIA Portal (S7-1200)"),
            ("Allen-Bradley: CompactLogix y MicroLogix", "Allen-Bradley: CompactLogix & MicroLogix"),
            ("Studio 5000: Ladder y Structured Text", "Studio 5000: Ladder & Structured Text"),
            ("Estándar IEC 61131-3", "IEC 61131-3 standard"),
            ("SCADA / HMI", "SCADA / HMI"),
            ("Factory I/O, LabVIEW y MATLAB", "Factory I/O, LabVIEW & MATLAB"),
        }),
        new("bi-robot", ("Robótica y CNC", "Robotics & CNC"), new[]
        {
            ("Robots FANUC", "FANUC robots"),
            ("Robots KUKA (KR C4 / smartPAD)", "KUKA robots (KR C4 / smartPAD)"),
            ("Robots ABB (RAPID, nivel básico)", "ABB robots (RAPID, basic level)"),
            ("CNC con FluidNC y G-code", "CNC with FluidNC & G-code"),
            ("Neumática y electroneumática", "Pneumatics & electro-pneumatics"),
        }),
        new("bi-lightning-charge", ("Piso y eléctrico", "Shop floor & electrical"), new[]
        {
            ("Cableado de tableros, sensores y motores", "Wiring of panels, sensors and motors"),
            ("I/O check y power-up de equipos", "I/O check and equipment power-up"),
            ("Lectura de diagramas (Ethernet, I/O, 24 V, 120 V)", "Reading diagrams (Ethernet, I/O, 24 V, 120 V)"),
            ("Manejo de BOM y control de materiales", "BOM handling and material control"),
            ("Seguridad: LOTO y NFPA 70E", "Safety: LOTO and NFPA 70E"),
        }),
        new("bi-motherboard", ("Embebidos y diseño", "Embedded & design"), new[]
        {
            ("ESP32 / ESP32-S3", "ESP32 / ESP32-S3"),
            ("Diseño de PCB (I/O aisladas a 24 V)", "PCB design (isolated 24 V I/O)"),
            ("KiCad", "KiCad"),
            ("SOLIDWORKS (certificado CSWP)", "SOLIDWORKS (CSWP certified)"),
            ("AutoCAD", "AutoCAD"),
        }),
        new("bi-code-slash", ("Software", "Software"), new[]
        {
            ("C# / .NET 10", "C# / .NET 10"),
            ("ASP.NET Core Web API y EF Core", "ASP.NET Core Web API & EF Core"),
            ("Blazor (Server y WebAssembly)", "Blazor (Server & WebAssembly)"),
            ("WPF y WinForms", "WPF & WinForms"),
            ("SQL Server, PostgreSQL y Supabase", "SQL Server, PostgreSQL & Supabase"),
            ("TypeScript, React y Next.js", "TypeScript, React & Next.js"),
            ("Python, Java y C++", "Python, Java & C++"),
            ("Git", "Git"),
        }),
        new("bi-building-gear", ("Manufactura", "Manufacturing"), new[]
        {
            ("OEE e IATF 16949", "OEE & IATF 16949"),
            ("Lean Six Sigma", "Lean Six Sigma"),
            ("Troqueles progresivos de estampado", "Progressive stamping dies"),
            ("Sistemas CTPAT", "CTPAT systems"),
            ("Etiquetado ZPL", "ZPL labeling"),
            ("Gestión de inventarios IT", "IT inventory management"),
        }),
    };

    private string T((string Es, string En) text) => LangApp.IsSpanish ? text.Es : text.En;

    protected override void OnInitialized()
    {
        LangApp.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LangApp.OnLanguageChanged -= StateHasChanged;
    }
}
