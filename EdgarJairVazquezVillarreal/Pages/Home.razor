@page "/"
@inject EdgarJairVazquezVillarreal.Services.LanguageService LangApp
@implements IDisposable

<PageTitle>Edgar Jair Vazquez V. — @LangApp.Get("HeroRole1")</PageTitle>

<!-- ── Hero ───────────────────────────────────────────────────────── -->
<section class="hero">
    <div class="row align-items-center g-4">
        <div class="col-xl-7">
            <p class="hero-eyebrow scroll-reveal">@LangApp.Get("HeroGreeting")</p>

            <h1 class="hero-name scroll-reveal">
                Edgar Jair <span class="text-gradient d-block">Vazquez Villarreal</span>
            </h1>

            <!-- El texto lo teclea js/animations.js a partir de data-typed -->
            <p class="hero-role scroll-reveal">
                <span class="hero-role-prompt" aria-hidden="true">&gt;</span><span class="typed-text" data-typed="@string.Join('|', Roles)" aria-hidden="true"></span>
                <span class="visually-hidden">@string.Join(", ", Roles)</span>
            </p>

            <p class="hero-tagline scroll-reveal">@LangApp.Get("HeroTagline")</p>

            <div class="hero-actions scroll-reveal">
                <a href="projects" class="btn btn-primary">
                    <i class="bi bi-grid-1x2-fill me-2"></i>@LangApp.Get("ViewProjects")
                </a>
                <a href="ImagenesDocs/CVEdgarJairVazquezVillarreal.pdf"
                   class="btn btn-outline-primary" target="_blank">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i>@LangApp.Get("DownloadCV")
                </a>
            </div>

            <div class="hero-social scroll-reveal">
                <a href="https://github.com/Kaiser1088" target="_blank" aria-label="GitHub">
                    <i class="bi bi-github"></i>
                </a>
                <a href="https://www.linkedin.com/in/edgar-vazquez-83b9431b8/" target="_blank" aria-label="LinkedIn">
                    <i class="bi bi-linkedin"></i>
                </a>
                <a href="contact" aria-label="@LangApp.Get("NavContact")">
                    <i class="bi bi-envelope-fill"></i>
                </a>
            </div>
        </div>

        <!-- Tarjeta decorativa (siempre oscura, como el sidebar): una celda de ejemplo
             vista desde mis tres áreas. El ladder lee los sensores, el robot mueve la
             pieza y el código sigue el ciclo. Todo va sincronizado con CSS (app.css,
             sección "INICIO — CELDA DE DEMOSTRACIÓN"); aquí solo está el dibujo. -->
        <div class="col-xl-5" aria-hidden="true">
            <div class="hero-visual scroll-reveal">
                <div class="code-card demo-card float-soft" data-bs-theme="dark">
                    <div class="code-card-bar">
                        <span class="code-card-dot"></span>
                        <span class="code-card-dot"></span>
                        <span class="code-card-dot"></span>
                        <span class="code-card-file">@T(("celda-demo", "demo-cell"))</span>
                        <span class="sim-run"><span class="sim-run-dot"></span>RUN</span>
                    </div>

                    <!-- 1 · PLC: cada instrucción se enciende cuando es verdadera -->
                    <div class="demo-pane">
                        <span class="pane-tag">PLC · Ladder</span>
                        <svg class="ladder" viewBox="0 0 360 118" focusable="false">
                            <line class="lad-rail" x1="16" y1="24" x2="16" y2="112" />
                            <line class="lad-rail" x1="344" y1="24" x2="344" y2="112" />

                            <path class="lad-wire" d="M16,34 H66 M74,34 H293.5 M306.5,34 H344
                                                       M16,60 H66 M74,60 H293.5 M306.5,60 H344
                                                       M16,86 H66 M74,86 H166 M174,86 H293.5 M306.5,86 H344
                                                       M16,106 H66 M74,106 H110 V86" />
                            <circle class="lad-node" cx="110" cy="86" r="2" />

                            <!-- Renglón 1: hay pieza (S1) → ciclo del robot -->
                            <g class="lad-i sig sig-s1">
                                <path d="M66,28 V40 M74,28 V40" />
                                <text x="70" y="23">S1</text>
                            </g>
                            <g class="lad-i sig sig-s1">
                                <circle cx="300" cy="34" r="5.5" />
                                <path d="M296,27.5 q-5,6.5 0,13 M304,27.5 q5,6.5 0,13" />
                                <text x="300" y="23">ROBOT</text>
                            </g>

                            <!-- Renglón 2: no hay pieza (S1 cerrado) → banda de entrada M1 -->
                            <g class="lad-i sig sig-s1n">
                                <path d="M66,54 V66 M74,54 V66 M65,66 L75,54" />
                                <text x="70" y="49">S1</text>
                            </g>
                            <g class="lad-i sig sig-s1n">
                                <circle cx="300" cy="60" r="5.5" />
                                <path d="M296,53.5 q-5,6.5 0,13 M304,53.5 q5,6.5 0,13" />
                                <text x="300" y="49">M1</text>
                            </g>

                            <!-- Renglón 3: pieza entregada (S2) arranca la banda de salida M2,
                                 M2 se enclava y el sensor de fin de banda (S3) la detiene -->
                            <g class="lad-i sig sig-s2">
                                <path d="M66,80 V92 M74,80 V92" />
                                <text x="70" y="75">S2</text>
                            </g>
                            <g class="lad-i sig sig-s3n">
                                <path d="M166,80 V92 M174,80 V92 M165,92 L175,80" />
                                <text x="170" y="75">S3</text>
                            </g>
                            <g class="lad-i sig sig-m2">
                                <circle cx="300" cy="86" r="5.5" />
                                <path d="M296,79.5 q-5,6.5 0,13 M304,79.5 q5,6.5 0,13" />
                                <text x="300" y="75">M2</text>
                            </g>
                            <g class="lad-i sig sig-m2">
                                <path d="M66,100 V112 M74,100 V112" />
                                <text x="92" y="103">M2</text>
                            </g>
                        </svg>
                    </div>

                    <!-- 2 · Robótica: el brazo se dibuja recto hacia arriba y cada
                         articulación gira sobre su propio eje -->
                    <div class="demo-pane sim-view">
                        <span class="pane-tag">@T(("Robótica", "Robotics"))</span>
                        <svg class="robot-cell" viewBox="0 6 360 176" focusable="false">
                            <!-- Torreta de señalización -->
                            <line class="rb-pole" x1="44" y1="100" x2="44" y2="144" />
                            <rect class="rb-lamp rb-lamp-red"   x="38" y="70" width="12" height="9" rx="2" />
                            <rect class="rb-lamp rb-lamp-amber" x="38" y="80" width="12" height="9" rx="2" />
                            <rect class="rb-lamp rb-lamp-green" x="38" y="90" width="12" height="9" rx="2" />

                            <line class="rb-floor" x1="8" y1="176" x2="352" y2="176" />

                            <!-- Banda de entrada: motor M1 y sensor S1 en el punto de toma -->
                            <g class="rb-conveyor">
                                <line class="rb-leg" x1="24" y1="153" x2="24" y2="176" />
                                <line class="rb-leg" x1="120" y1="153" x2="120" y2="176" />
                                <rect x="18" y="144" width="108" height="9" rx="4.5" />
                                <line class="rb-belt rb-belt-in" x1="38" y1="148.5" x2="122" y2="148.5" />
                            </g>
                            <g class="rb-io sig sig-s1n"><text x="27" y="151.3">M1</text></g>
                            <g class="rb-io sig sig-s1">
                                <rect class="rb-sensor" x="89" y="155" width="14" height="8" rx="2" />
                                <circle cx="96" cy="159" r="2" />
                                <text x="96" y="173">S1</text>
                            </g>

                            <!-- Banda de salida: motor M2, sensor S2 donde se deja la pieza
                                 y sensor S3 al final -->
                            <g class="rb-conveyor">
                                <line class="rb-leg" x1="240" y1="153" x2="240" y2="176" />
                                <line class="rb-leg" x1="336" y1="153" x2="336" y2="176" />
                                <rect x="234" y="144" width="108" height="9" rx="4.5" />
                                <line class="rb-belt rb-belt-out" x1="238" y1="148.5" x2="322" y2="148.5" />
                            </g>
                            <g class="rb-io sig sig-m2"><text x="333" y="151.3">M2</text></g>
                            <g class="rb-io sig sig-s2">
                                <rect class="rb-sensor" x="257" y="155" width="14" height="8" rx="2" />
                                <circle cx="264" cy="159" r="2" />
                                <text x="264" y="173">S2</text>
                            </g>
                            <g class="rb-io sig sig-s3">
                                <rect class="rb-sensor" x="317" y="155" width="14" height="8" rx="2" />
                                <circle cx="324" cy="159" r="2" />
                                <text x="324" y="173">S3</text>
                            </g>

                            <!-- Pieza que llega y pieza que se va -->
                            <g class="rb-box rb-box-in">
                                <rect x="85" y="126" width="22" height="18" rx="2" />
                                <line x1="96" y1="126" x2="96" y2="144" />
                            </g>
                            <g class="rb-box rb-box-out">
                                <rect x="253" y="126" width="22" height="18" rx="2" />
                                <line x1="264" y1="126" x2="264" y2="144" />
                            </g>

                            <!-- Robot: base fija y tres articulaciones anidadas -->
                            <rect class="rb-base" x="162" y="162" width="36" height="14" rx="3" />
                            <rect class="rb-base" x="171" y="132" width="18" height="32" rx="4" />
                            <g class="rb-j1">
                                <rect class="rb-link" x="174" y="66" width="12" height="70" rx="6" />
                                <g class="rb-j2">
                                    <rect class="rb-link rb-link-2" x="175" y="15" width="10" height="62" rx="5" />
                                    <g class="rb-j3">
                                        <rect class="rb-tool" x="178" y="20" width="4" height="15" />
                                        <rect class="rb-tool" x="167" y="34" width="26" height="6" rx="2" />
                                        <rect class="rb-finger rb-finger-l" x="166" y="40" width="3" height="11" rx="1" />
                                        <rect class="rb-finger rb-finger-r" x="191" y="40" width="3" height="11" rx="1" />
                                        <g class="rb-box rb-box-carried">
                                            <rect x="169" y="40" width="22" height="18" rx="2" />
                                            <line x1="180" y1="40" x2="180" y2="58" />
                                        </g>
                                    </g>
                                    <circle class="rb-joint" cx="180" cy="20" r="5" />
                                </g>
                                <circle class="rb-joint" cx="180" cy="72" r="6.5" />
                            </g>
                            <circle class="rb-joint" cx="180" cy="130" r="8" />
                        </svg>
                    </div>

                    <!-- 3 · Software: se resalta la línea que corresponde al paso del ciclo -->
                    <div class="demo-pane">
                        <span class="pane-tag pane-tag-end">Software · C#</span>
                        <div class="code-card-body is-compact">
                            <div class="code-line"><span class="tk-kw">while</span> (@T(("celda.EnMarcha", "cell.Running"))) {</div>
                            <div class="code-line code-step code-step-wait">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-kw">await</span> s1.<span class="tk-type">@T(("EsperarPieza", "WaitForPart"))</span>();</div>
                            <div class="code-line code-step code-step-pick">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-kw">var</span> @T(("pieza", "part")) = <span class="tk-kw">await</span> robot.<span class="tk-type">@T(("Tomar", "Pick"))</span>();</div>
                            <div class="code-line code-step code-step-place">&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-kw">await</span> robot.<span class="tk-type">@T(("Dejar", "Place"))</span>(@T(("pieza", "part")));</div>
                            <div class="code-line code-step code-step-log">&nbsp;&nbsp;&nbsp;&nbsp;db.<span class="tk-type">@T(("Registrar", "Log"))</span>(@T(("pieza", "part")));</div>
                            <div class="code-line">}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Cifras ─────────────────────────────────────────────────────── -->
<section class="stat-band scroll-reveal">
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="2">2</span></div>
        <div class="stat-label">@LangApp.Get("StatErp")</div>
    </div>
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="120">120</span>+</div>
        <div class="stat-label">@LangApp.Get("StatEndpoints")</div>
    </div>
    <div class="stat">
        <div class="stat-value"><span class="counter" data-target="900">900</span>+</div>
        <div class="stat-label">@LangApp.Get("StatTests")</div>
    </div>
    <div class="stat">
        <div class="stat-value">CSWP</div>
        <div class="stat-label">@LangApp.Get("StatCswp")</div>
    </div>
</section>

<!-- ── Proyectos destacados ───────────────────────────────────────── -->
<section class="home-section">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-stars"></i>@LangApp.Get("HomeFeaturedTitle")</h2>
        <a href="projects" class="section-link">
            @LangApp.Get("HomeAllProjects")<i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row">
        @foreach (var project in Featured)
        {
            <div class="@(project.Wide ? "col-12" : "col-lg-6") mb-4">
                <div class="card h-100 featured-card scroll-reveal">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="featured-icon"><i class="bi @project.Icon"></i></div>
                            <div>
                                <h3 class="h5 card-title mb-0">@project.Name</h3>
                                <div class="featured-subtitle">@LangApp.Get(project.SubtitleKey)</div>
                            </div>
                        </div>
                        <p class="card-text">@LangApp.Get(project.DescKey)</p>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (var tag in project.Tags)
                            {
                                <span class="badge badge-glass">@tag</span>
                            }
                        </div>
                        <a href="@project.Href" class="featured-link stretched-link mt-auto">
                            @LangApp.Get("ViewDocs")<i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ── Sigue explorando ───────────────────────────────────────────── -->
<!-- El inicio solo presenta; el detalle de cada tema vive en su página. -->
<section class="home-section mb-5">
    <div class="section-head scroll-reveal">
        <h2 class="section-heading"><i class="bi bi-compass-fill"></i>@T(("Sigue explorando", "Keep exploring"))</h2>
    </div>

    <div class="row">
        @foreach (var link in Explore)
        {
            <div class="col-xl-4 mb-4">
                <div class="glass-card mini-card explore-card scroll-reveal h-100">
                    <span class="mini-icon"><i class="bi @link.Icon"></i></span>
                    <div>
                        <h3 class="mini-name">
                            <a href="@link.Href" class="stretched-link">@LangApp.Get(link.TitleKey)</a>
                        </h3>
                        <p class="mini-detail">@T(link.Detail)</p>
                    </div>
                    <i class="bi bi-arrow-right explore-arrow"></i>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record FeaturedProject(string Name, string Icon, string SubtitleKey, string DescKey, string Href, string[] Tags, bool Wide = false);

    private record ExploreLink(string TitleKey, string Icon, string Href, (string Es, string En) Detail);

    // Frases que se teclean en el hero
    private string[] Roles => new[]
    {
        LangApp.Get("HeroRole1"),
        LangApp.Get("HeroRole2"),
        LangApp.Get("HeroRole3"),
        LangApp.Get("HeroRole4"),
    };

    private static readonly FeaturedProject[] Featured =
    {
        new("CNCIMS", "bi-vector-pen", "ProjCncSubtitle", "ProjCncDesc", "docs/cncims",
            new[] { "C# / .NET 10", "WPF", "ESP32-S3", "FluidNC", "G-code", "DXF" }, Wide: true),
        new("VAVILL", "bi-buildings", "ProjVavillSubtitle", "ProjVavillDesc", "docs/vavill",
            new[] { ".NET 8", "Blazor WebAssembly", "RCL Modular", "SQL Server" }),
        new("EsmeraldaPoint", "bi-shop", "ProjEsmeraldaSubtitle", "ProjEsmeraldaDesc", "docs/esmeraldapoint",
            new[] { "ASP.NET Core 10", "Blazor", "WPF", "PostgreSQL" }),
    };

    private static readonly ExploreLink[] Explore =
    {
        new("NavAboutMe", "bi-person-fill", "about",
            ("Perfil, formación, certificaciones y habilidades.", "Profile, education, certifications and skills.")),
        new("NavExperience", "bi-calendar-event-fill", "experience",
            ("Mi trayectoria en piso y en software.", "My path on the shop floor and in software.")),
        new("NavContact", "bi-envelope-fill", "contact",
            ("Correo, LinkedIn y GitHub.", "Email, LinkedIn and GitHub.")),
    };

    private string T((string Es, string En) text) => LangApp.IsSpanish ? text.Es : text.En;

    protected override void OnInitialized()
    {
        LangApp.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LangApp.OnLanguageChanged -= StateHasChanged;
    }
}
