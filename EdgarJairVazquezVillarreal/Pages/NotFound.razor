@page "/not-found"
@inject EdgarJairVazquezVillarreal.Services.LanguageService LangApp
@implements IDisposable

<PageTitle>@LangApp.Get("NotFoundTitle")</PageTitle>

<!-- También se muestra para cualquier ruta desconocida (ver App.razor) -->
<section class="not-found">
    <p class="not-found-code text-gradient" aria-hidden="true">404</p>
    <h1 class="h3 fw-bold">@LangApp.Get("NotFoundTitle")</h1>
    <p class="text-secondary mb-4">@LangApp.Get("NotFoundText")</p>
    <a href="" class="btn btn-primary">
        <i class="bi bi-house-fill me-2"></i>@LangApp.Get("BackHome")
    </a>
</section>

@code {
    protected override void OnInitialized()
    {
        LangApp.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LangApp.OnLanguageChanged -= StateHasChanged;
    }
}
