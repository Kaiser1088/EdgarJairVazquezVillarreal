@page "/docs/vavill"
@inherits DocPageBase

<PageTitle>VAVILL - @T("Documentación", "Documentation")</PageTitle>

<DocPage Title="VAVILL"
         Subtitle="@LangApp.Get("ProjVavillSubtitle")"
         Icon="bi-buildings"
         Status="@LangApp.Get("StatusInDevelopment")"
         Tags="@Tags">

    <DocSection Id="descripcion" Icon="bi-info-circle" Title="@T("Descripción General", "General Description")">
        <p class="doc-lead scroll-reveal">@LangApp.Get("ProjVavillDesc")</p>
    </DocSection>

    @if (Gallery.Length > 0)
    {
        <DocSection Id="capturas" Icon="bi-images" Title="@T("Capturas", "Screenshots")">
            <DocGallery Images="@Gallery" />
        </DocSection>
    }

    <DocSection Id="modulos" Icon="bi-boxes" Title="@T("Módulos Principales", "Main Modules")">
        <div class="doc-grid">
            @foreach (var module in Modules)
            {
                <DocCard Icon="@module.Icon" Title="@T(module.Title)" Description="@T(module.Description)">
                    <ul class="tech-list">
                        @foreach (var item in module.Items)
                        {
                            <li>@T(item)</li>
                        }
                    </ul>
                </DocCard>
            }
        </div>
    </DocSection>

    <DocSection Id="metricas" Icon="bi-bar-chart" Title="@T("Métricas del Proyecto", "Project Metrics")">
        <div class="doc-metrics">
            <DocMetric Value="9"   Label="@T("Proyectos .NET", ".NET Projects")" />
            <DocMetric Value="120" Suffix="+" Label="Endpoints REST" />
            <DocMetric Value="100" Label="@T("Entidades BD", "DB Entities")" />
            <DocMetric Value="6"   Label="@T("Bases SQL", "SQL DBs")" />
            <DocMetric Value="30"  Label="@T("Migraciones", "Migrations")" />
            <DocMetric Value="18"  Suffix="k+" Label="@T("Líneas Código", "Lines of Code")" />
        </div>
    </DocSection>

    <DocSection Id="arquitectura" Icon="bi-diagram-3" Title="@T("Arquitectura del Sistema", "System Architecture")">
        <p class="doc-lead scroll-reveal">
            @T("La plataforma sigue un diseño de Monolito Modular separando el backend, frontend y dominios de negocio. Cada área funcional está encapsulada en proyectos aislados, permitiendo compilación, pruebas y despliegue independientes.",
               "The platform follows a Modular Monolith design, separating backend, frontend, and business domains. Each functional area is encapsulated in isolated projects, allowing independent compilation, testing, and deployment.")
        </p>

        <div class="doc-grid doc-grid-2 mt-4">
            <DocCard Title="@("1. " + T("Núcleo", "Core") + " (Host & Client)")">
                <ul class="tech-list">
                    @foreach (var project in CoreProjects)
                    {
                        <li><strong>@project.Name:</strong> @T(project.Es, project.En)</li>
                    }
                </ul>
            </DocCard>
            <DocCard Title="@("2. " + T("Módulos de Dominio", "Domain Modules") + " (RCL)")">
                <ul class="tech-list">
                    @foreach (var project in DomainProjects)
                    {
                        <li><strong>@project.Name:</strong> @T(project.Es, project.En)</li>
                    }
                </ul>
            </DocCard>
        </div>

        <!-- Diagrama de interacción -->
        <div class="doc-diagram mt-4 scroll-reveal">
            <h3 class="doc-diagram-title">@T("Diagrama de Interacción", "Interaction Diagram")</h3>

            <div class="diagram-core">
                <div class="diagram-node diagram-node-main">
                    <i class="bi bi-server"></i>VAVILL (Server API)
                </div>
                <div class="diagram-link"><span>HTTP</span></div>
                <div class="diagram-node diagram-node-main">
                    <i class="bi bi-browser-chrome"></i>VAVILL.Client (WASM)
                </div>
            </div>

            <div class="diagram-shared"><i class="bi bi-link-45deg me-1"></i>VAVILL.Shared</div>

            <div class="diagram-divider">
                <span>@T("Dependencias Módulos", "Module Dependencies")</span>
            </div>

            <div class="diagram-modules">
                @foreach (var node in DiagramModules)
                {
                    <div class="diagram-module">
                        <i class="bi bi-arrow-down"></i>
                        <div class="diagram-node">@node.Name<small>(Razor Lib)</small></div>
                        @if (node.Database is not null)
                        {
                            <div class="diagram-db">
                                <i class="bi bi-database"></i>@node.Database
                                @if (node.Storage is not null)
                                {
                                    <div class="diagram-db-extra">
                                        <i class="bi bi-folder2-open"></i>@node.Storage
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </DocSection>

    <DocSection Id="stack" Icon="bi-code-square" Title="@T("Stack Tecnológico", "Technology Stack")">
        <div class="doc-tags scroll-reveal">
            @foreach (var tech in Stack)
            {
                <span class="badge badge-glass">@tech</span>
            }
        </div>
    </DocSection>

    <DocSection Id="destacados" Icon="bi-lightbulb" Title="@T("Puntos Destacables de Arquitectura", "Architecture Highlights")">
        <div class="doc-callout scroll-reveal">
            <ul class="tech-list">
                @foreach (var highlight in Highlights)
                {
                    <li><strong>@T(highlight.Title):</strong> @T(highlight.Detail)</li>
                }
            </ul>
        </div>
    </DocSection>
</DocPage>

