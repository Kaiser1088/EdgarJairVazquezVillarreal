@page "/docs/esmeraldapoint"
@inherits DocPageBase

<PageTitle>EsmeraldaPoint - @T("Documentación", "Documentation")</PageTitle>

<DocPage Title="EsmeraldaPoint"
         Subtitle="@LangApp.Get("ProjEsmeraldaSubtitle")"
         Icon="bi-shop"
         Tags="@Tags">

    <DocSection Id="descripcion" Icon="bi-info-circle" Title="@T("Descripción General", "Overview")">
        <p class="doc-lead scroll-reveal">
            @T("Sistema empresarial completo desarrollado desde cero para una tortillería en Monclova, Coahuila. Cubre ventas, inventario, recursos humanos, proveedores y finanzas, con arquitectura distribuida entre dos ciudades.",
               "Full-featured business system built from scratch for a tortilla manufacturer in Monclova, Coahuila. It covers sales, inventory, human resources, suppliers and finance, with an architecture distributed across two cities.")
        </p>

        <div class="doc-metrics mt-4">
            <DocMetric Value="5"  Label="@T("Proyectos .NET", ".NET projects")" />
            <DocMetric Value="20" Label="@T("Tablas en la base de datos", "Database tables")" />
            <DocMetric Value="6"  Label="@T("Módulos de datos", "Data modules")" />
            <DocMetric Value="2"  Label="@T("Ciudades conectadas", "Connected cities")" />
        </div>
    </DocSection>

    @if (Gallery.Length > 0)
    {
        <DocSection Id="capturas" Icon="bi-images" Title="@T("Capturas", "Screenshots")">
            <DocGallery Images="@Gallery" />
        </DocSection>
    }

    <DocSection Id="arquitectura" Icon="bi-diagram-3" Title="@T("Arquitectura", "Architecture")">
        <p class="doc-text scroll-reveal">
            @T("Es una solución con 5 proyectos en .NET 10:", "A solution with 5 projects on .NET 10:")
        </p>
        <DocCard>
            <ul class="tech-list">
                @foreach (var project in SolutionProjects)
                {
                    <li><strong>@project.Name:</strong> @T(project.Es, project.En)</li>
                }
            </ul>
        </DocCard>
    </DocSection>

    <DocSection Id="base-de-datos" Icon="bi-database" Title="@T("Base de Datos", "Database")">
        <div class="doc-tags mb-3 scroll-reveal">
            <span class="badge badge-glass">PostgreSQL</span>
            <span class="badge badge-glass">Entity Framework Core 10</span>
            <span class="badge badge-glass">Code First</span>
        </div>
        <p class="doc-text scroll-reveal">
            @T("Base de datos PostgreSQL con 20 tablas diseñadas y normalizadas, organizadas en 6 módulos:",
               "PostgreSQL database with 20 designed and normalized tables, organized into 6 modules:")
        </p>
        <DocCard>
            <ul class="tech-list tech-list-cols">
                @foreach (var module in DataModules)
                {
                    <li>@T(module)</li>
                }
            </ul>
        </DocCard>
        <p class="doc-text mt-3 mb-0 scroll-reveal">
            @T("Implementada con Entity Framework Core 10 usando enfoque Code First con migraciones, índices únicos y relaciones bien definidas.",
               "Implemented with Entity Framework Core 10 using a Code First approach with migrations, unique indexes and well-defined relationships.")
        </p>
    </DocSection>

    <DocSection Id="tecnologias" Icon="bi-code-square" Title="@T("Tecnologías Utilizadas", "Technologies Used")">
        <div class="doc-grid doc-grid-2">
            <DocCard Icon="bi-hdd-rack" Title="Backend">
                <ul class="tech-list">
                    <li>ASP.NET Core 10</li>
                    <li>Entity Framework Core 10</li>
                    <li>PostgreSQL &amp; Npgsql</li>
                    <li>Swashbuckle (Swagger)</li>
                </ul>
            </DocCard>
            <DocCard Icon="bi-window-stack" Title="@T("Frontend y Herramientas", "Frontend & Tools")">
                <ul class="tech-list">
                    <li>WPF (.NET 10)</li>
                    <li>Blazor Server / WebAssembly</li>
                    <li>Visual Studio 2026</li>
                    <li>pgAdmin 4, dotnet-ef CLI, Git</li>
                </ul>
            </DocCard>
        </div>
    </DocSection>

    <DocSection Id="funcionalidades" Icon="bi-check2-square" Title="@T("Funcionalidades Implementadas", "Implemented Features")">
        <DocCard>
            <ul class="tech-list tech-list-cols">
                @foreach (var feature in Features)
                {
                    <li>@T(feature)</li>
                }
            </ul>
        </DocCard>
    </DocSection>

    <DocSection Id="decisiones" Icon="bi-lightbulb" Title="@T("Decisiones de Arquitectura Destacables", "Notable Architecture Decisions")">
        <div class="doc-callout scroll-reveal">
            <ul class="tech-list">
                @foreach (var decision in Decisions)
                {
                    <li><strong>@T(decision.Title):</strong> @T(decision.Detail)</li>
                }
            </ul>
        </div>
    </DocSection>
</DocPage>

