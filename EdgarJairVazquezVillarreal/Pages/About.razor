@page "/about"
@inject EdgarJairVazquezVillarreal.Services.LanguageService LangApp
@implements IDisposable

<PageTitle>@LangApp.Get("NavAboutMe")</PageTitle>

<!-- Todo lo que habla de mí como persona y profesionista: perfil, formación,
     certificaciones, habilidades y logros. El trabajo va en Experiencia. -->
<div class="about-page mt-4 mb-5">

    <header class="page-head scroll-reveal">
        <h1 class="page-title">@LangApp.Get("NavAboutMe")</h1>
        <p class="page-subtitle">@LangApp.Get("AboutSubtitle")</p>
    </header>

    <!-- Índice: js/animations.js hace el scroll y marca la sección activa -->
    <nav class="doc-nav" aria-label="@T(("Secciones", "Sections"))">
        @foreach (var section in Sections)
        {
            <button type="button" class="doc-nav-link" data-scroll-to="@section.Id" @key="section.Id">
                @T(section.Title)
            </button>
        }
    </nav>

    <!-- ── Perfil ─────────────────────────────────────────────────── -->
    <section id="perfil" class="doc-section">
        <div class="section-head scroll-reveal">
            <h2 class="section-heading"><i class="bi bi-person-fill"></i>@T(Sections[0].Title)</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <p class="about-lead scroll-reveal">@LangApp.Get("BioP1")</p>
                <p class="about-lead scroll-reveal">@LangApp.Get("BioP2")</p>

                <p class="about-goal scroll-reveal">
                    <i class="bi bi-signpost-split-fill"></i>
                    <span><strong>@LangApp.Get("BioGoalLabel"):</strong> @LangApp.Get("BioGoal")</span>
                </p>
            </div>

            <div class="col-lg-5">
                <div class="glass-card fact-card scroll-reveal">
                    <h3 class="fact-card-title">@T(("En resumen", "At a glance"))</h3>
                    <dl class="fact-list">
                        <div class="fact">
                            <dt><i class="bi bi-briefcase-fill"></i>@T(("Puesto actual", "Current role"))</dt>
                            <dd>@LangApp.Get("Exp0Title") · Magna</dd>
                        </div>
                        <div class="fact">
                            <dt><i class="bi bi-mortarboard-fill"></i>@T(("Formación", "Education"))</dt>
                            <dd>@LangApp.Get("Edu1Degree")</dd>
                        </div>
                        <div class="fact">
                            <dt><i class="bi bi-geo-alt-fill"></i>@T(("Ubicación", "Location"))</dt>
                            <dd>@LangApp.Get("Edu1Location")</dd>
                        </div>
                        <div class="fact">
                            <dt><i class="bi bi-translate"></i>@LangApp.Get("LanguagesTitle")</dt>
                            <dd>@LangApp.Get("LangSpanish") · @LangApp.Get("LangEnglish")</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Formación académica ────────────────────────────────────── -->
    <section id="formacion" class="doc-section">
        <div class="section-head scroll-reveal">
            <h2 class="section-heading"><i class="bi bi-mortarboard-fill"></i>@T(Sections[1].Title)</h2>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="glass-card edu-card scroll-reveal h-100">
                    <span class="badge badge-glass">2025</span>
                    <h3 class="edu-title">@LangApp.Get("Edu1Degree")</h3>
                    <p class="edu-school">@LangApp.Get("Edu1School")</p>
                    <p class="timeline-meta">
                        <span><i class="bi bi-geo-alt-fill"></i>@LangApp.Get("Edu1Location")</span>
                    </p>
                    <ul class="tech-list mb-0">
                        <li>@LangApp.Get("Edu1Specialty")</li>
                        <li>@LangApp.Get("Edu1B1")</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="glass-card edu-card scroll-reveal h-100">
                    <span class="badge badge-glass">2017</span>
                    <h3 class="edu-title">@LangApp.Get("Edu2School")</h3>
                    <p class="timeline-meta">
                        <span><i class="bi bi-geo-alt-fill"></i>@LangApp.Get("Edu2Location")</span>
                    </p>
                    <ul class="tech-list mb-0">
                        <li>@LangApp.Get("Edu2B1")</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Certificaciones y cursos ───────────────────────────────── -->
    <section id="certificaciones" class="doc-section">
        <div class="section-head scroll-reveal">
            <h2 class="section-heading"><i class="bi bi-patch-check-fill"></i>@T(Sections[2].Title)</h2>
        </div>

        <div class="row">
            @foreach (var cert in Certifications)
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="glass-card mini-card scroll-reveal h-100">
                        <span class="mini-icon"><i class="bi @cert.Icon"></i></span>
                        <div>
                            <h3 class="mini-name">@T(cert.Name)</h3>
                            <p class="mini-detail">@T(cert.Detail)</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ── Habilidades ────────────────────────────────────────────── -->
    <section id="habilidades" class="doc-section">
        <div class="section-head scroll-reveal">
            <h2 class="section-heading"><i class="bi bi-tools"></i>@T(Sections[3].Title)</h2>
        </div>

        <div class="row">
            @foreach (var group in Skills)
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="glass-card scroll-reveal h-100 p-4">
                        <h3 class="h5 mb-3 text-neon">
                            <i class="bi @group.Icon me-2"></i>@T(group.Title)
                        </h3>
                        <ul class="tech-list mb-0">
                            @foreach (var item in group.Items)
                            {
                                <li>@T(item)</li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ── Logros y participaciones ───────────────────────────────── -->
    <section id="logros" class="doc-section">
        <div class="section-head scroll-reveal">
            <h2 class="section-heading"><i class="bi bi-trophy-fill"></i>@T(Sections[4].Title)</h2>
        </div>

        <div class="row">
            <div class="col-md-6 scroll-reveal">
                <p><strong>@LangApp.Get("RoboticsSkills"):</strong></p>
                <ul class="list-unstyled">
                    <li>
                        <i class="bi bi-trophy-fill text-warning me-2"></i>
                        <strong>@LangApp.Get("RobotBattle2018"):</strong>
                        @LangApp.Get("ParticipationWithTeamDynamo")
                    </li>
                    <li>
                        <i class="bi bi-trophy-fill text-warning me-2"></i>
                        <strong>@LangApp.Get("RobotCIM"):</strong>
                        @LangApp.Get("ParticipationWithTeamDynamoInCategories")
                    </li>
                    <li>
                        <i class="bi bi-trophy-fill text-warning me-2"></i>
                        <strong>@LangApp.Get("StateRoboticsNL"):</strong>
                        @LangApp.Get("FirstAndSecondPlaceInSumoAndMinisumo")
                    </li>
                </ul>
            </div>

            <div class="col-md-6 scroll-reveal">
                <p><strong>@LangApp.Get("TechnologicalInnovation"):</strong></p>
                <ul class="list-unstyled">
                    <li>
                        <i class="bi bi-award-fill text-warning me-2"></i>
                        @LangApp.Get("ParticipationScienceFair2019")
                    </li>
                    <li>
                        <i class="bi bi-award-fill text-warning me-2"></i>
                        @LangApp.Get("ParticipationScienceFair2020")
                    </li>
                </ul>
            </div>
        </div>
    </section>
</div>

@code {
    private record Section(string Id, (string Es, string En) Title);

    private record Certification(string Icon, (string Es, string En) Name, (string Es, string En) Detail);

    private record SkillGroup(string Icon, (string Es, string En) Title, (string Es, string En)[] Items);

    // El orden de esta lista es el orden del índice y de la página.
    private static readonly Section[] Sections =
    {
        new("perfil",          ("Perfil", "Profile")),
        new("formacion",       ("Formación académica", "Education")),
        new("certificaciones", ("Certificaciones y cursos", "Certifications & courses")),
        new("habilidades",     ("Habilidades", "Skills")),
        new("logros",          ("Logros y participaciones", "Achievements")),
    };

    // Para agregar una certificación o curso basta una línea más.
    private static readonly Certification[] Certifications =
    {
        new("bi-box-fill",
            ("CSWP · Certified SOLIDWORKS Professional", "CSWP · Certified SOLIDWORKS Professional"),
            ("Dassault Systèmes", "Dassault Systèmes")),
        new("bi-graph-up-arrow",
            ("Lean Six Sigma White Belt", "Lean Six Sigma White Belt"),
            ("Folio SSWB1455-586", "ID SSWB1455-586")),
        new("bi-code-slash",
            ("C# / .NET", "C# / .NET"),
            ("Microsoft Learn", "Microsoft Learn")),
        new("bi-cup-hot-fill",
            ("Java", "Java"),
            ("Oracle / Alura", "Oracle / Alura")),
        new("bi-database-fill",
            ("SQL Server", "SQL Server"),
            ("Alura", "Alura")),
        new("bi-shield-fill-check",
            ("Seguridad industrial", "Industrial safety"),
            ("LOTO · seguridad eléctrica (NOM-029-STPS / NFPA 70E) · trabajos en caliente · maquinaria rotativa",
             "LOTO · electrical safety (NOM-029-STPS / NFPA 70E) · hot work · rotating machinery")),
    };

    // Habilidades por área. Para agregar una basta una línea en su grupo.
    private static readonly SkillGroup[] Skills =
    {
        new("bi-cpu", ("PLC y controles", "PLC & controls"), new[]
        {
            ("Siemens TIA Portal (S7-1200)", "Siemens TIA Portal (S7-1200)"),
            ("Allen-Bradley: CompactLogix y MicroLogix", "Allen-Bradley: CompactLogix & MicroLogix"),
            ("Studio 5000: Ladder y Structured Text", "Studio 5000: Ladder & Structured Text"),
            ("Estándar IEC 61131-3", "IEC 61131-3 standard"),
            ("SCADA / HMI", "SCADA / HMI"),
            ("Factory I/O, LabVIEW y MATLAB", "Factory I/O, LabVIEW & MATLAB"),
        }),
        new("bi-robot", ("Robótica y CNC", "Robotics & CNC"), new[]
        {
            ("Robots FANUC", "FANUC robots"),
            ("Robots KUKA (KR C4 / smartPAD)", "KUKA robots (KR C4 / smartPAD)"),
            ("Robots ABB (RAPID, nivel básico)", "ABB robots (RAPID, basic level)"),
            ("CNC con FluidNC y G-code", "CNC with FluidNC & G-code"),
            ("Neumática y electroneumática", "Pneumatics & electro-pneumatics"),
        }),
        new("bi-lightning-charge", ("Piso y eléctrico", "Shop floor & electrical"), new[]
        {
            ("Cableado de tableros, sensores y motores", "Wiring of panels, sensors and motors"),
            ("I/O check y power-up de equipos", "I/O check and equipment power-up"),
            ("Lectura de diagramas (Ethernet, I/O, 24 V, 120 V)", "Reading diagrams (Ethernet, I/O, 24 V, 120 V)"),
            ("Manejo de BOM y control de materiales", "BOM handling and material control"),
            ("Seguridad: LOTO y NFPA 70E", "Safety: LOTO and NFPA 70E"),
        }),
        new("bi-motherboard", ("Embebidos y diseño", "Embedded & design"), new[]
        {
            ("ESP32 / ESP32-S3", "ESP32 / ESP32-S3"),
            ("Diseño de PCB (I/O aisladas a 24 V)", "PCB design (isolated 24 V I/O)"),
            ("KiCad", "KiCad"),
            ("SOLIDWORKS (certificado CSWP)", "SOLIDWORKS (CSWP certified)"),
            ("AutoCAD", "AutoCAD"),
        }),
        new("bi-code-slash", ("Software", "Software"), new[]
        {
            ("C# / .NET 10", "C# / .NET 10"),
            ("ASP.NET Core Web API y EF Core", "ASP.NET Core Web API & EF Core"),
            ("Blazor (Server y WebAssembly)", "Blazor (Server & WebAssembly)"),
            ("WPF y WinForms", "WPF & WinForms"),
            ("SQL Server, PostgreSQL y Supabase", "SQL Server, PostgreSQL & Supabase"),
            ("TypeScript, React y Next.js", "TypeScript, React & Next.js"),
            ("Python, Java y C++", "Python, Java & C++"),
            ("Git", "Git"),
        }),
        new("bi-building-gear", ("Manufactura", "Manufacturing"), new[]
        {
            ("OEE e IATF 16949", "OEE & IATF 16949"),
            ("Lean Six Sigma", "Lean Six Sigma"),
            ("Troqueles progresivos de estampado", "Progressive stamping dies"),
            ("Sistemas CTPAT", "CTPAT systems"),
            ("Etiquetado ZPL", "ZPL labeling"),
            ("Gestión de inventarios IT", "IT inventory management"),
        }),
    };

    private string T((string Es, string En) text) => LangApp.IsSpanish ? text.Es : text.En;

    protected override void OnInitialized()
    {
        LangApp.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LangApp.OnLanguageChanged -= StateHasChanged;
    }
}
