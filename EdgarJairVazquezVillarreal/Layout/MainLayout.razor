@inherits LayoutComponentBase
@inject EdgarJairVazquezVillarreal.Services.ThemeService ThemeApp
@inject NavigationManager Nav

<div class="page">
    <!-- El sidebar siempre es oscuro independientemente del tema global -->
    <div class="sidebar" data-bs-theme="dark">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
        </div>

        <article class="content px-4">
            <!-- La key es la URL: al navegar se recrea el contenedor y se repite la animación de entrada -->
            <div class="page-transition" @key="Nav.Uri">
                @Body
            </div>
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Lee el tema desde localStorage y aplica data-bs-theme al elemento <html>
        await ThemeApp.InitializeAsync();
    }
}
